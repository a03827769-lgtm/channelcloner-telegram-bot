# ==============================================================================
# Telegram Channel Cloner — Production .gitignore
# ==============================================================================

# 1. Environment variables & Secrets (CRITICAL)
.env
.env.*
!.env.example
*.env
*.env.local
cloud_env_ready.txt
cloud_raw_session.txt
cloud_*.txt
app.pid
app.lock
*.token
*.secret
*.key
*.pem
*.cer
oracle_vps.key
**/.vault_key
docker-compose.override.yml

# 2. Telethon & Pyrogram MTProto Session Files
*.session
*.session-journal
*.session*

# 3. SQLite Databases, backups & WAL journal files
*.db
*.db-wal
*.db-shm
*.db-journal
*.sqlite
*.sqlite3
database/*.db*
database/*.sqlite*
backups/
data/
test_stars.db
test_next_gen.db
tests/*.db

# 4. Media downloads & temporary storage
temp_media/*
!temp_media/.gitkeep
temp_media/
temp_media_test/
*.tmp
*.bak
test.txt

# 5. Python cache & compiled bytecode
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# 6. Virtual environments
venv/
.venv/
env/
ENV/

# 7. IDE, OS, tooling & Agent metadata
.idea/
.vscode/
*.swp
*.swo
.DS_Store
Thumbs.db
.agents/
.gemini/
.pytest_cache/
.ruff_cache/
.coverage
logs/
*.log

# 8. Cloudflare Tunnel: config and credentials stay on the host (see .cloudflared/config.yml.example)
.cloudflared/*
!.cloudflared/config.yml.example
cloudflared.exe

# 9. Frontend dependencies & build artefacts (install with `npm ci` in webapp/)
node_modules/
webapp/vite.config.ts.timestamp-*
