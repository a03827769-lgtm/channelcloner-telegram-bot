# ==============================================================================
# Telegram Channel Cloner — Production .gitignore
# ==============================================================================

# 1. Environment variables & Secrets (CRITICAL)
.env
.env.*
!.env.example
*.env
*.env.local
cloud_env_ready.txt
*.token
*.secret
*.key
*.pem
*.cer

# 2. Telethon & Pyrogram MTProto Session Files
*.session
*.session-journal
*.session*

# 3. SQLite Databases & WAL journal files
*.db
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
database/*.db*
database/*.sqlite*
test_stars.db
test_next_gen.db
tests/*.db

# 4. Media downloads & temporary storage
temp_media/*
!temp_media/.gitkeep
temp_media/
*.tmp
*.bak
test.txt

# 5. Python cache & compiled bytecode
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# 6. Virtual environments
venv/
.venv/
env/
ENV/

# 7. IDE, OS & Agent metadata
.idea/
.vscode/
*.swp
*.swo
.DS_Store
Thumbs.db
.agents/
.gemini/
.pytest_cache/
.coverage
