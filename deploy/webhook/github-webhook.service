# Template — installed by `sudo bash deploy/oracle_master_setup.sh --with-webhook`, which replaces
# __APP_USER__ / __APP_DIR__ and creates /etc/channelcloner/webhook.env (WEBHOOK_SECRET=..., root only).
# The listener binds to 127.0.0.1 only; nginx publishes it over HTTPS as /deploy-webhook.
[Unit]
Description=GitHub webhook deployer for Telegram Channel Cloner (release tags)
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=simple
User=__APP_USER__
WorkingDirectory=__APP_DIR__
Environment=PROJECT_DIR=__APP_DIR__
Environment=WEBHOOK_BIND=127.0.0.1
Environment=WEBHOOK_PORT=9000
EnvironmentFile=/etc/channelcloner/webhook.env
ExecStart=/usr/bin/python3 __APP_DIR__/deploy/webhook/deploy_webhook.py
Restart=always
RestartSec=10
NoNewPrivileges=true
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
