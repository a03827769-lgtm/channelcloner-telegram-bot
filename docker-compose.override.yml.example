# Example local overrides for docker compose.
# Copy to docker-compose.override.yml (git-ignored); `docker compose` merges it automatically.
# Only settings the application reads are useful here (see config/settings.py and .env.example).

services:
  telegram-cloner:
    environment:
      # Bot API through an HTTP/SOCKS proxy (PROXY_URL in config/settings.py).
      # HTTP_PROXY/HTTPS_PROXY pointing at Docker Desktop's internal proxy are ignored by run.py.
      # PROXY_URL: "socks5://user:password@proxy.example.com:1080"
      ENABLE_PLAYWRIGHT: "false"
    # Smaller hosts:
    # mem_limit: 1g
    # cpus: 1.0
