# ==============================================================================
# Telegram Channel Cloner — .dockerignore
# The image contains application code only. `**/` patterns match at any depth
# (plain patterns are anchored to the build-context root).
# ==============================================================================

# VCS, CI and tooling
.git
.github
.gitignore
.gitattributes
.dockerignore
.agents
.gemini
.vscode
.idea
**/__pycache__
**/*.py[cod]
**/.pytest_cache
**/.ruff_cache
**/.coverage
.venv
venv
env

# Secrets & credentials (CRITICAL)
**/.env
**/.env.*
**/*.env
**/.vault_key
**/*.key
**/*.pem
**/*.cer
**/*.token
**/*.secret
**/*.session
**/*.session-journal
**/cloud_env_ready.txt
**/cloud_*.txt
.cloudflared
**/.cloudflared
app.pid
**/app.pid
app.lock
**/app.lock

# Databases, runtime data, logs and backups
**/*.db
**/*.db-wal
**/*.db-shm
**/*.db-journal
**/*.sqlite
**/*.sqlite3
data
logs
backups
**/backups
temp_media
temp_media_test
**/*.log
**/*.bak
**/*.tmp

# Frontend dependencies and build output (the image builds webapp/ itself)
**/node_modules
webapp/dist
webapp/vite.config.ts.timestamp-*

# Host binaries and tooling that never run inside the image
**/*.exe
cloudflared*
scripts
deploy
tests
docker-compose*.yml
render.yaml
Procfile
setup_wizard.py
*.md
