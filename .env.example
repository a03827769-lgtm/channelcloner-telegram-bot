# ==============================================================================
# Telegram Channel Cloner — konfiguratsiya namunasi
#
# Nusxa oling:  cp .env.example .env   (yoki: python setup_wizard.py)
# MUHIM: .env faylini hech qachon git'ga qo'shmang va hech kimga yubormang.
# Bo'sh qoldirilgan maxfiy qiymatlar (token, hash, kalit) albatta to'ldirilishi kerak.
# "#" bilan boshlangan qatorlar ixtiyoriy: standart qiymat yetarli bo'lsa, tegmang.
# ==============================================================================

# --- Telegram botlar (@BotFather) -------------------------------------------------
# Asosiy (ommaviy) bot tokeni — majburiy
BOT_TOKEN=
# Alohida admin bot tokeni (tavsiya etiladi; BOT_TOKEN bilan bir xil bo'lmasin)
ADMIN_BOT_TOKEN=

# --- Telethon MTProto (https://my.telegram.org) -----------------------------------
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
# StringSession (setup_wizard.py yaratadi) yoki admin bot orqali OTP bilan ulanish
TELETHON_SESSION=

# --- Administratorlar -------------------------------------------------------------
# Asosiy super admin Telegram ID raqami (@userinfobot orqali bilish mumkin)
PRIMARY_SUPER_ADMIN_ID=
# Qo'shimcha super adminlar: vergul bilan ajratilgan ID lar
ADMIN_IDS=

# --- Xavfsizlik --------------------------------------------------------------------
# Sessiyalar va zaxira nusxalarni shifrlovchi master kalit. Bo'sh bo'lsa, mashinaga
# bog'langan kalit fayli (VAULT_KEY_PATH) avtomatik yaratiladi. Kalitni yo'qotsangiz,
# shifrlangan sessiyalar va zaxiralarni ochib bo'lmaydi — nusxasini xavfsiz joyda saqlang.
# Yangi kalit: python -c "import os, base64; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
ENCRYPTION_KEY=
# VAULT_KEY_PATH=database/.vault_key

# --- Mini App ----------------------------------------------------------------------
# Mini App ochiladigan doimiy HTTPS manzil (nomli Cloudflare tunnel domeni)
# WEBAPP_URL=https://app.example.com

# --- Qo'llab-quvvatlash --------------------------------------------------------------
# Private rejimda yangi foydalanuvchilarga ko'rsatiladigan admin @username
# SUPPORT_USERNAME=admin

# --- Ixtiyoriy xizmatlar --------------------------------------------------------------
# AI parafraz (Google Gemini)
# GEMINI_API_KEY=
# Bot API so'rovlari uchun proksi, masalan: socks5://user:pass@host:1080
# PROXY_URL=

# --- Ishga tushirish parametrlari (standart qiymatlar) --------------------------------
# SQLite baza fayli (Docker/Render ichida /app/data/cloner.db ishlatiladi)
# DB_PATH=database/cloner.db
# Vaqtinchalik media katalogi
# TEMP_DOWNLOAD_DIR=temp_media
# HTTP server porti (health, Mini App, API)
# PORT=8080
# Playwright Chromium renderi (ko'p RAM talab qiladi; standart: Pillow)
# ENABLE_PLAYWRIGHT=false
# Ishga tushganda Telegram'dagi kutilayotgan yangilanishlarni tashlab yuborish
# DROP_PENDING_UPDATES=false
# Kod o'zgarganda jarayonni qayta ishga tushirish (faqat ishlab chiqish uchun!)
# AUTO_RELOAD=false

# --- Infratuzilma (docker compose / Windows watchdog) --------------------------------
# docker-compose `miniapp_web` lokal porti
# MINIAPP_WEB_PORT=8081
# `docker-bot` profili: hostdagi loopback port (nginx shu portga proksi qiladi)
# BOT_HTTP_PORT=8080
# Docker obrazga Playwright Chromium qo'shish (build arg)
# INSTALL_PLAYWRIGHT=false
# Windows watchdog kuzatadigan nomli tunnel (cloudflared tunnel run <nom>)
# CLOUDFLARED_TUNNEL_NAME=miniapp
