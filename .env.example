# ==============================================================================
# Telegram Channel Cloner — Environment Variables Template (.env.example)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Telegram Bot Tokens (from @BotFather)
# ------------------------------------------------------------------------------
# Primary public client bot token (@klonlabot)
BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrsTUVwxyz

# Dedicated admin management bot token (@klonlaadminbot)
ADMIN_BOT_TOKEN=9876543210:AAEdummyAdminTokenExample1234567890

# ------------------------------------------------------------------------------
# 2. Telegram MTProto Userbot API Credentials (from https://my.telegram.org)
# ------------------------------------------------------------------------------
# Telegram App api_id from my.telegram.org -> API development tools
TELEGRAM_API_ID=12345678

# Telegram App api_hash from my.telegram.org (32 hex characters)
TELEGRAM_API_HASH=0123456789abcdef0123456789abcdef

# ------------------------------------------------------------------------------
# 3. Telethon StringSession (Cloud Deployment / Never-Sleep)
# ------------------------------------------------------------------------------
# Telethon StringSession string (raw or encrypted format enc:...).
# Required for ephemeral cloud PaaS (Koyeb / Render) to preserve userbot authentication across deploys.
TELETHON_SESSION=

# ------------------------------------------------------------------------------
# 4. Super Admin Telegram User IDs
# ------------------------------------------------------------------------------
# Comma-separated list of Super Admin Telegram User IDs
ADMIN_IDS=123456789,987654321

# ------------------------------------------------------------------------------
# 5. Database & Storage Configuration
# ------------------------------------------------------------------------------
# SQLite primary database file path
DB_PATH=database/cloner.db

# Temporary directory for media buffering and watermarking
TEMP_DOWNLOAD_DIR=temp_media

# ------------------------------------------------------------------------------
# 6. 24/7 Keep-Alive HTTP Healthcheck Server Port
# ------------------------------------------------------------------------------
# HTTP port for Koyeb / Render / Railway keep-alive pingers (defaults to 8080)
PORT=8080
