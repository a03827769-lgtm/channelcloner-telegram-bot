# Telegram Channel Cloner Configuration
# MUHIM: Bu faylni hech qachon git'ga qo'shmang!
# Copy this to .env and fill in your actual values

BOT_TOKEN=YOUR_BOT_TOKEN_HERE
TELEGRAM_API_ID=YOUR_API_ID_HERE
TELEGRAM_API_HASH=YOUR_API_HASH_HERE
TELETHON_SESSION=
ADMIN_IDS=YOUR_ADMIN_ID_HERE
ADMIN_BOT_TOKEN=YOUR_ADMIN_BOT_TOKEN_HERE
DB_PATH=database/cloner.db
TEMP_DOWNLOAD_DIR=temp_media

# Xavfsizlik: Alohida shifrlash kaliti (majburiy tavsiya etiladi)
# Yangi kalit yaratish uchun: python -c "import os, base64; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
ENCRYPTION_KEY=YOUR_ENCRYPTION_KEY_HERE

# Support Contact Username (Private Mode paytida yangi foydalanuvchilarga ko'rsatiladigan admin @username)
SUPPORT_USERNAME=admin
