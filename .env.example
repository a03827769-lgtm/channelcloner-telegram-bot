# =========================================================
# Telegram Channel Cloner — Environment Variables Template
# =========================================================

# 1. Telegram Bot Tokens (from @BotFather)
BOT_TOKEN=YOUR_PUBLIC_BOT_TOKEN_HERE
ADMIN_BOT_TOKEN=YOUR_ADMIN_BOT_TOKEN_HERE

# 2. Telegram MTProto Userbot API Credentials (from https://my.telegram.org)
TELEGRAM_API_ID=12345678
TELEGRAM_API_HASH=your_telegram_api_hash_here

# 3. Telethon StringSession (Auto-loaded from DB or paste StringSession here for cloud deployment)
TELETHON_SESSION=

# 4. Bot Admin Telegram User IDs (comma-separated, e.g. 123456789,987654321)
ADMIN_IDS=123456789

# 5. Application Paths & Server Port
DB_PATH=database/cloner.db
TEMP_DOWNLOAD_DIR=temp_media
PORT=8080
