# Normalise line endings: LF in the repository and on Linux hosts/containers,
# CRLF only for Windows-native scripts that need it.
* text=auto eol=lf

*.ps1 text eol=crlf
*.vbs text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary assets
*.png -text
*.jpg -text
*.jpeg -text
*.gif -text
*.webp -text
*.ico -text
*.mp3 -text
*.mp4 -text
*.woff -text
*.woff2 -text
*.ttf -text
*.exe -text
*.zip -text
*.enc -text
